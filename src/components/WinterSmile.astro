---
import { smileLocalesData, type SmileLocaleCopy } from '@/data/smile-locales-data';
import { type Lang } from '@/i18n/ui';
import '@/styles/winter-smile.css';

const { lang = 'en' } = Astro.props as { lang: Lang };
const t: SmileLocaleCopy = smileLocalesData[lang] || smileLocalesData.en;
const base = import.meta.env.BASE_URL;
const root = `${base}winter-smile/`;
const asset = (name: string) => root + 'media/' + name;
const canonical = "https://www.imeclinic.com/all-inclusive-smile/";

const results = [
  'result-01.webp', 'result-02.webp', 'result-03.webp', 'result-04.webp', 'result-05.webp',
  'result-06.webp', 'result-07.webp', 'result-08.webp', 'result-09.webp', 'result-10.webp'
];

const videos = [
  { thumb: 'dental-centre-tour-20261028.webp', title: t.vid1Title, time: '2:15' },
  { thumb: 'doctor-veneers-en.webp', title: t.vid2Title, time: '1:45' },
  { thumb: 'treatment-rooms.webp', title: t.vid3Title, time: '1:30' },
  { thumb: 'dental-laboratory.webp', title: t.vid4Title, time: '2:00' },
  { thumb: 'natural-smile-640.webp', title: t.vid5Title, time: '1:10' },
  { thumb: 'airport-flight-640.webp', title: t.vid6Title, time: '2:40' }
];

const flags: Record<string, string> = {
  en: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 30" width="22" height="15"><clipPath id="f-en-c"><path d="M0 0v30h60V0z"/></clipPath><clipPath id="f-en-d"><path d="M30 15h30v15zv15H0zH0V0zV0h30z"/></clipPath><g clip-path="url(#f-en-c)"><path d="M0 0v30h60V0z" fill="#012169"/><path d="m0 0 60 30m0-30L0 30" stroke="#fff" stroke-width="6"/><path d="m0 0 60 30m0-30L0 30" clip-path="url(#f-en-d)" stroke="#C8102E" stroke-width="4"/><path d="M30 0v30M0 15h60" stroke="#fff" stroke-width="10"/><path d="M30 0v30M0 15h60" stroke="#C8102E" stroke-width="6"/></g></svg>`,
  tr: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="15" viewBox="0 -30000 90000 60000"><path fill="#e30a17" d="M0-30000h90000v60000H0z"/><path fill="#fff" d="m41750 0 13568-4408-8386 11541V-7133l8386 11541zm925 8021a15000 15000 0 1 1 0-16042 12000 12000 0 1 0 0 16042z"/></svg>`,
  ru: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 9 6" width="22" height="15"><path fill="#fff" d="M0 0h9v3H0z"/><path fill="#d52b1e" d="M0 3h9v3H0z"/><path fill="#0039a6" d="M0 2h9v2H0z"/></svg>`,
  es: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 3 2" width="22" height="15"><rect width="3" height="2" fill="#c60b1e"/><rect width="3" height="1" y=".5" fill="#ffc400"/></svg>`,
  it: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="15" viewBox="0 0 3 2"><path fill="#009246" d="M0 0h3v2H0z"/><path fill="#fff" d="M1 0h2v2H1z"/><path fill="#ce2b37" d="M2 0h1v2H2z"/></svg>`
};
---
<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{t.metaTitle}</title>
    <meta name="description" content={t.metaDesc}/>
    <meta name="robots" content="noindex, nofollow"/>
    <meta name="theme-color" content="#0c2a3b"/>
    <link rel="canonical" href={canonical}/>
    <meta property="og:title" content={t.metaTitle}/>
    <meta property="og:description" content={t.metaDesc}/>
    <meta property="og:url" content={canonical}/>
    <meta property="og:site_name" content="IME Clinic"/>
    <meta property="og:type" content="website"/>
    <meta property="og:image" content={`${canonical}lp-assets/all-inclusive-smile/hero-1280.webp`}/>
    <meta property="og:image:width" content="1280"/>
    <meta property="og:image:height" content="721"/>
    <link rel="icon" href={`${base}favicon.svg`}/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  </head>
  <body data-landing-route="dental-treatments" data-theme="dental">
    <!-- Top Announcement Bar -->
    <aside class="_2onN3q_bar" aria-label="Announcement">
      <div class="wrap _2onN3q_inner">
        <span class="badge _2onN3q_left">
          <span class="_2onN3q_pulse"></span>
          <span class="_2onN3q_label" data-i18n="topLabel">{t.topLabel}</span>
        </span>
        <span class="_2onN3q_offer" data-i18n="topOffer">{t.topOffer}</span>
        <span class="_2onN3q_place" data-i18n="topPlace">{t.topPlace}</span>
      </div>
    </aside>

    <!-- Sticky Main Header -->
    <header class="hBw1pG_header" id="top">
      <div class="wrap hBw1pG_bar">
        <a class="hBw1pG_brand" href="#top" aria-label="IME Clinic">
          <img src={`${base}ime-clinic-logo.svg`} alt="IME Clinic" width="136" height="32" style="display:block;height:32px;width:auto;"/>
        </a>

        <nav class="compact-navigation" aria-label="Navigation">
          <div class="compact-navigation-links">
            <a href="#package" data-i18n="navPackage">{t.navPackage}</a>
            <a href="#journey" data-i18n="navJourney">{t.navJourney}</a>
            <a href="#stay" data-i18n="navStay">{t.navStay}</a>
            <a href="#videos" data-i18n="navVideos">{t.navVideos}</a>
            <a href="#results" data-i18n="navResults">{t.navResults}</a>
            <a href="#faq" data-i18n="navFaq">{t.navFaq}</a>
          </div>
          <details class="compact-navigation-menu">
            <summary aria-label="Menu">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </summary>
            <div>
              <a href="#package" data-i18n="navPackage">{t.navPackage}</a>
              <a href="#journey" data-i18n="navJourney">{t.navJourney}</a>
              <a href="#stay" data-i18n="navStay">{t.navStay}</a>
              <a href="#videos" data-i18n="navVideos">{t.navVideos}</a>
              <a href="#results" data-i18n="navResults">{t.navResults}</a>
              <a href="#faq" data-i18n="navFaq">{t.navFaq}</a>
            </div>
          </details>
        </nav>

        <div class="hBw1pG_right">
          <!-- Single-URL in-place language switcher -->
          <div class="Dw-EXq_root" id="lang-dropdown">
            <button type="button" class="Dw-EXq_trigger" id="lang-trigger" aria-haspopup="listbox" aria-expanded="false" aria-label="Select language">
              <span class="Dw-EXq_flag" id="active-flag" set:html={flags[lang]}></span>
              <span class="Dw-EXq_code" id="active-lang-code">{lang.toUpperCase()}</span>
              <svg class="Dw-EXq_caret" width="16" height="16" viewBox="0 0 256 256" aria-hidden="true"><path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z"></path></svg>
            </button>
            <div class="Dw-EXq_menu" id="lang-menu" role="listbox" style="display:none;">
              <a class="Dw-EXq_item" href="?lang=en" data-lang="en" aria-current={lang === 'en' ? 'true' : undefined}>
                <span class="Dw-EXq_flag" set:html={flags.en}></span>
                <span class="Dw-EXq_name">English</span>
              </a>
              <a class="Dw-EXq_item" href="?lang=tr" data-lang="tr" aria-current={lang === 'tr' ? 'true' : undefined}>
                <span class="Dw-EXq_flag" set:html={flags.tr}></span>
                <span class="Dw-EXq_name">Türkçe</span>
              </a>
              <a class="Dw-EXq_item" href="?lang=ru" data-lang="ru" aria-current={lang === 'ru' ? 'true' : undefined}>
                <span class="Dw-EXq_flag" set:html={flags.ru}></span>
                <span class="Dw-EXq_name">Русский</span>
              </a>
              <a class="Dw-EXq_item" href="?lang=es" data-lang="es" aria-current={lang === 'es' ? 'true' : undefined}>
                <span class="Dw-EXq_flag" set:html={flags.es}></span>
                <span class="Dw-EXq_name">Español</span>
              </a>
              <a class="Dw-EXq_item" href="?lang=it" data-lang="it" aria-current={lang === 'it' ? 'true' : undefined}>
                <span class="Dw-EXq_flag" set:html={flags.it}></span>
                <span class="Dw-EXq_name">Italiano</span>
              </a>
            </div>
          </div>
          <button type="button" class="btn btn--sm btn--primary hBw1pG_cta cta-whatsapp-btn">
            <span data-i18n="ctaConsultation">{t.ctaConsultation}</span><span aria-hidden="true">↗</span>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <!-- Dental Hero Section with Clean Mosaic (NO text/disclaimers on/under images) -->
      <section class="dental-hero dental-sales-hero dental-story-hero" aria-labelledby="hero-title">
        <div class="wrap dental-hero-grid">
          <div class="dental-hero-copy">
            <header class="dental-hero-heading">
              <p class="eyebrow" data-i18n="heroEyebrow">{t.heroEyebrow}</p>
              <h1 id="hero-title" class="display">
                <span data-i18n="heroTitle">{t.heroTitle}</span> <em data-i18n="heroAccent">{t.heroAccent}</em>
              </h1>
              <p class="dental-hero-lead" data-i18n="heroLead">{t.heroLead}</p>
            </header>

            <div class="dental-hero-prices">
              <div class="dental-hero-price">
                <span data-i18n="pkgPriceLabel">{t.pkgPriceLabel}</span>
                <p><strong data-i18n="pkgPriceVal">{t.pkgPriceVal}</strong><small data-i18n="pkgPriceUnit">{t.pkgPriceUnit}</small></p>
              </div>
              <div class="dental-hero-price">
                <span data-i18n="crownPriceLabel">{t.crownPriceLabel}</span>
                <p><strong data-i18n="crownPriceVal">{t.crownPriceVal}</strong><small data-i18n="crownPriceUnit">{t.crownPriceUnit}</small></p>
              </div>
            </div>

            <div class="dental-hero-actions">
              <a href="#package" class="btn btn--primary" data-i18n="heroCta">{t.heroCta}<span aria-hidden="true">↗</span></a>
              <a href="#videos" class="dental-hero-secondary">
                <span aria-hidden="true">▷</span><span data-i18n="heroSecondary">{t.heroSecondary}</span>
              </a>
            </div>
          </div>

          <!-- 3-Tile Clean Mosaic: Verified Clinic, Restorations, Patient Smile (ZERO CAPTIONS) -->
          <div class="dental-hero-mosaic">
            <div class="dental-mosaic-clinic">
              <img src={asset('clinic-dental-unit.webp')} alt="" width="1200" height="675" fetchpriority="high"/>
            </div>
            <div class="dental-mosaic-products">
              <img src={asset('crown-restorations.webp')} alt="" width="900" height="600"/>
            </div>
            <div class="dental-mosaic-smile">
              <img src={asset('hero-1280.webp')} alt="" width="1280" height="721"/>
            </div>
          </div>
        </div>
      </section>

      <!-- Trust Band -->
      <section class="dental-facts" aria-label="Key facts">
        <div class="wrap">
          <ul>
            <li>
              <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true"><path d="m4.5 10 3.5 3.5 7.5-7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <div>
                <strong data-i18n="fact1Title">{t.fact1Title}</strong>
                <span data-i18n="fact1Desc">{t.fact1Desc}</span>
              </div>
            </li>
            <li>
              <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true"><path d="m4.5 10 3.5 3.5 7.5-7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <div>
                <strong data-i18n="fact2Title">{t.fact2Title}</strong>
                <span data-i18n="fact2Desc">{t.fact2Desc}</span>
              </div>
            </li>
            <li>
              <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true"><path d="m4.5 10 3.5 3.5 7.5-7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <div>
                <strong data-i18n="fact3Title">{t.fact3Title}</strong>
                <span data-i18n="fact3Desc">{t.fact3Desc}</span>
              </div>
            </li>
            <li>
              <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true"><path d="m4.5 10 3.5 3.5 7.5-7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <div>
                <strong data-i18n="fact4Title">{t.fact4Title}</strong>
                <span data-i18n="fact4Desc">{t.fact4Desc}</span>
              </div>
            </li>
          </ul>
        </div>
      </section>

      <!-- Package & Inclusions Section -->
      <section id="package" class="dental-options section" aria-labelledby="package-title">
        <div class="wrap">
          <header class="dental-options-heading">
            <div>
              <p class="eyebrow" data-i18n="pkgEyebrow">{t.pkgEyebrow}</p>
              <h2 class="h2" id="package-title" data-i18n="pkgTitle">{t.pkgTitle}</h2>
            </div>
            <p data-i18n="pkgLead">{t.pkgLead}</p>
          </header>

          <div class="dental-goal-grid">
            <div class="dental-goal dental-goal-1">
              <span class="dental-goal-number">01</span>
              <div>
                <h3 data-i18n="card1Title">{t.card1Title}</h3>
                <p data-i18n="card1Desc">{t.card1Desc}</p>
                <strong><span data-i18n="card1Detail">{t.card1Detail}</span><span>↗</span></strong>
              </div>
            </div>

            <div class="dental-goal dental-goal-2">
              <span class="dental-goal-number">02</span>
              <div>
                <h3 data-i18n="card2Title">{t.card2Title}</h3>
                <p data-i18n="card2Desc">{t.card2Desc}</p>
                <strong><span data-i18n="card2Detail">{t.card2Detail}</span><span>↗</span></strong>
              </div>
            </div>

            <div class="dental-goal">
              <span class="dental-goal-number">03</span>
              <div>
                <h3 data-i18n="card3Title">{t.card3Title}</h3>
                <p data-i18n="card3Desc">{t.card3Desc}</p>
                <strong><span data-i18n="card3Detail">{t.card3Detail}</span><span>↗</span></strong>
              </div>
            </div>
          </div>

          <div class="dental-package-terms" style="margin-top:24px;">
            <h3 data-i18n="scopeHeading">{t.scopeHeading}</h3>
            <p data-i18n="scopeText">{t.scopeText}</p>
          </div>
        </div>
      </section>

      <!-- 4-Stage Patient Journey Timeline -->
      <section id="journey" class="GoTIAa_section section" aria-labelledby="journey-title">
        <div class="wrap">
          <header class="GoTIAa_head">
            <p class="eyebrow" data-i18n="journeyEyebrow">{t.journeyEyebrow}</p>
            <h2 class="h2" id="journey-title" data-i18n="journeyTitle">{t.journeyTitle}</h2>
            <p class="lede" data-i18n="journeyLead">{t.journeyLead}</p>
          </header>

          <div class="GoTIAa_phases">
            <div class="GoTIAa_phase">
              <span class="GoTIAa_phaseBadge" data-i18n="step1Badge">{t.step1Badge}</span>
              <h3 class="GoTIAa_phaseTitle" data-i18n="step1Title">{t.step1Title}</h3>
              <p class="GoTIAa_phaseDesc" data-i18n="step1Desc">{t.step1Desc}</p>
            </div>
            <div class="GoTIAa_phase">
              <span class="GoTIAa_phaseBadge" data-i18n="step2Badge">{t.step2Badge}</span>
              <h3 class="GoTIAa_phaseTitle" data-i18n="step2Title">{t.step2Title}</h3>
              <p class="GoTIAa_phaseDesc" data-i18n="step2Desc">{t.step2Desc}</p>
            </div>
            <div class="GoTIAa_phase">
              <span class="GoTIAa_phaseBadge" data-i18n="step3Badge">{t.step3Badge}</span>
              <h3 class="GoTIAa_phaseTitle" data-i18n="step3Title">{t.step3Title}</h3>
              <p class="GoTIAa_phaseDesc" data-i18n="step3Desc">{t.step3Desc}</p>
            </div>
            <div class="GoTIAa_phase">
              <span class="GoTIAa_phaseBadge" data-i18n="step4Badge">{t.step4Badge}</span>
              <h3 class="GoTIAa_phaseTitle" data-i18n="step4Title">{t.step4Title}</h3>
              <p class="GoTIAa_phaseDesc" data-i18n="step4Desc">{t.step4Desc}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Stay & Clinic Facilities (NO captions/disclaimers on or under images) -->
      <section id="stay" class="PPsQba_section section" aria-labelledby="stay-title">
        <div class="wrap">
          <header class="dental-section-heading">
            <p class="eyebrow" data-i18n="stayEyebrow">{t.stayEyebrow}</p>
            <h2 class="h2" id="stay-title" data-i18n="stayTitle">{t.stayTitle}</h2>
            <p class="lede" data-i18n="stayLead">{t.stayLead}</p>
          </header>

          <div class="compact-stay-grid">
            <div class="facility-card">
              <div class="facility-photo">
                <img src={asset('clinic-dental-unit.webp')} alt="" width="600" height="375" loading="lazy"/>
              </div>
              <div class="facility-body">
                <h3 class="facility-title" data-i18n="fac1Title">{t.fac1Title}</h3>
                <p class="facility-desc" data-i18n="fac1Desc">{t.fac1Desc}</p>
              </div>
            </div>

            <div class="facility-card">
              <div class="facility-photo">
                <img src={asset('hotel-room.webp')} alt="" width="600" height="375" loading="lazy"/>
              </div>
              <div class="facility-body">
                <h3 class="facility-title" data-i18n="fac2Title">{t.fac2Title}</h3>
                <p class="facility-desc" data-i18n="fac2Desc">{t.fac2Desc}</p>
              </div>
            </div>

            <div class="facility-card">
              <div class="facility-photo">
                <img src={asset('hotel-lobby.webp')} alt="" width="600" height="375" loading="lazy"/>
              </div>
              <div class="facility-body">
                <h3 class="facility-title" data-i18n="fac3Title">{t.fac3Title}</h3>
                <p class="facility-desc" data-i18n="fac3Desc">{t.fac3Desc}</p>
              </div>
            </div>

            <div class="facility-card">
              <div class="facility-photo">
                <img src={asset('transfer-vehicle.webp')} alt="" width="600" height="375" loading="lazy"/>
              </div>
              <div class="facility-body">
                <h3 class="facility-title" data-i18n="fac4Title">{t.fac4Title}</h3>
                <p class="facility-desc" data-i18n="fac4Desc">{t.fac4Desc}</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Video Library Showcase -->
      <section id="videos" class="_5X57Ca_section section" aria-labelledby="videos-title">
        <div class="wrap">
          <header class="dental-section-heading">
            <p class="eyebrow" data-i18n="videosEyebrow">{t.videosEyebrow}</p>
            <h2 class="h2" id="videos-title" data-i18n="videosTitle">{t.videosTitle}</h2>
            <p class="lede" data-i18n="videosLead">{t.videosLead}</p>
          </header>

          <div class="_5X57Ca_grid">
            {videos.map((vid, idx) => (
              <div class="showcase-video" data-video-index={idx}>
                <img src={asset(vid.thumb)} alt="" width="360" height="640" loading="lazy"/>
                <div class="video-overlay">
                  <div class="video-play-btn" aria-label="Play video">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6 3 20 12 6 21 6 3"/></svg>
                  </div>
                  <p class="video-title" data-i18n={`vid${idx+1}Title`}>{vid.title}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Genuine Before / After Clinical Results Showcase (NO captions/disclaimers) -->
      <section id="results" class="YaK-iq_section section" aria-labelledby="results-title">
        <div class="wrap">
          <header class="YaK-iq_head">
            <p class="eyebrow" data-i18n="resultsEyebrow">{t.resultsEyebrow}</p>
            <h2 class="h2" id="results-title" data-i18n="resultsTitle">{t.resultsTitle}</h2>
            <p class="lede" data-i18n="resultsLead">{t.resultsLead}</p>
          </header>

          <div class="results-grid">
            {results.map((fileName, index) => (
              <div class="result-card" data-result-index={index} title="Click to zoom">
                <img src={asset(fileName)} alt="" width="480" height="360" loading="lazy"/>
                <div class="zoom-hint">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- FAQ Accordion -->
      <section id="faq" class="qibdya_section section" aria-labelledby="faq-title">
        <div class="wrap">
          <div class="qibdya_grid">
            <div>
              <p class="eyebrow" data-i18n="faqEyebrow">{t.faqEyebrow}</p>
              <h2 class="h2" id="faq-title" data-i18n="faqTitle">{t.faqTitle}</h2>
              <p class="lede" data-i18n="faqLead">{t.faqLead}</p>
            </div>

            <div class="qibdya_list">
              <details class="qibdya_item" name="faq">
                <summary class="qibdya_summary">
                  <span data-i18n="faq1Q">{t.faq1Q}</span>
