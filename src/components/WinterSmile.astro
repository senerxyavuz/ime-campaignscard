    <footer class="S6Hkya_footer">
      <div class="wrap S6Hkya_row">
        <img src={`${base}ime-clinic-logo.svg`} alt="IME Clinic" width="128" height="30" style="display:block;height:28px;width:auto;"/>
        <p class="S6Hkya_address">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M128,64a40,40,0,1,0,40,40A40,40,0,0,0,128,64Zm0,64a24,24,0,1,1,24-24A24,24,0,0,1,128,128Zm0-112a88.1,88.1,0,0,0-88,88c0,31.4,14.51,64.68,42,96.25a254.19,254.19,0,0,0,41.45,38.3,8,8,0,0,0,9.18,0A254.19,254.19,0,0,0,174,200.25c27.45-31.57,42-64.85,42-96.25A88.1,88.1,0,0,0,128,16Zm0,206c-16.53-13-72-60.75-72-118a72,72,0,0,1,144,0C200,161.23,144.53,209,128,222Z"></path></svg>
          <span>Ataköy 7-8-9-10. Kısım Mah. Çobançeşme E5 Yan Yol Cad. No: 16/1, 15. Kat, Ofis 111, Bakırköy, Istanbul</span>
        </p>
        <nav class="S6Hkya_links" aria-label="Footer">
          <a href="https://www.imeclinic.com/privacy-policy" target="_blank" rel="noopener">Privacy policy</a>
        </nav>
      </div>
      <div class="wrap S6Hkya_legal">
        <span data-i18n="legalText">{t.legalText}</span>
      </div>
    </footer>

    <!-- Mobile Sticky WhatsApp Bar -->
    <aside class="SynduG_bar" aria-label="Quick contact">
      <div class="SynduG_inner">
        <div class="SynduG_copy">
          <span class="SynduG_eyebrow" data-i18n="stickyEyebrow">{t.stickyEyebrow}</span>
          <strong class="SynduG_price">€3,000</strong>
        </div>
        <button type="button" class="btn btn--primary btn--sm cta-whatsapp-btn">
          <span data-i18n="stickyCta">{t.stickyCta}</span><span aria-hidden="true">↗</span>
        </button>
      </div>
    </aside>

    <!-- Modal Dialogs for Case Zoom and Video -->
    <div class="dialog-overlay" id="image-dialog" role="dialog" aria-modal="true" aria-label="Clinical Result Zoom">
      <div class="dialog-content">
        <button type="button" class="dialog-close" id="image-dialog-close" aria-label="Close dialog">✕</button>
        <img id="image-dialog-img" src="" alt="Clinical Result"/>
      </div>
    </div>

    <div class="dialog-overlay" id="video-dialog" role="dialog" aria-modal="true" aria-label="Video Player">
      <div class="dialog-content" style="max-width:400px; aspect-ratio:9/16; background:#000;">
        <button type="button" class="dialog-close" id="video-dialog-close" aria-label="Close dialog">✕</button>
        <div id="video-dialog-container" style="width:100%;height:100%;display:grid;place-items:center;color:#fff;">
          <p>Video loading...</p>
        </div>
      </div>
    </div>

    <!-- Complete JSON Translations Dictionary -->
    <script id="smile-translations" type="application/json" set:html={JSON.stringify(smileLocalesData)}></script>

    <!-- Client Script -->
    <script src="@/scripts/winter-smile-client.ts"></script>
