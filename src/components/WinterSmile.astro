            <h2 class="h2" id="consult-title" data-i18n="nextTitle">{t.nextTitle}</h2>
            <p data-i18n="nextLead">{t.nextLead}</p>
          </div>
          <div class="dental-next-actions">
            <button type="button" class="btn btn--primary cta-whatsapp-btn">
              <span data-i18n="whatsappCta">{t.whatsappCta}</span><span aria-hidden="true">↗</span>
            </button>
          </div>
        </div>
      </section>
