---
import { smileCopy } from '@/data/winter-locales';
import { smileTerms } from '@/data/winter-smile';
import media from '@/data/winter-media.json';
import { langOrder,languages,type Lang } from '@/i18n/ui';
import '@/styles/winter-smile.css';
import { smilePath, smileOrigin } from '@/data/smile-paths.mjs';
import { smileVisuals } from '@/data/winter-visuals';
const {lang}=Astro.props as {lang:Lang};
const c=smileCopy[lang];
const visual=smileVisuals[lang];
const base=import.meta.env.BASE_URL;
const root=`${base}winter-smile/`;
const asset=(name:string)=>root+'media/'+name;
const route=smilePath(lang);
const canonical=smileOrigin+route;
const price=new Intl.NumberFormat(lang,{style:'currency',currency:'EUR',maximumFractionDigits:0}).format(smileTerms.price);
const anchors=['package','journey','places','library','questions'];
const localizedMedia=media.items.map((item:any,index:number)=>({...item,src:asset(item.src),thumb:asset(item.thumb),title:item.labels?.[lang]?.title||`${c.categories[item.category]} · ${String(index+1).padStart(2,'0')}`}));
const posters=[1,2].map(n=>({id:`campaign-${n}`,category:0,src:`${root}art/winter-${lang}-${n}.jpg`,thumb:`${root}art/winter-${lang}-${n}.jpg`,title:`${c.campaignCaption} · ${n}`}));
const items=[...posters,...localizedMedia];
const clinicVideo=media.videos[0] as any;
const doctorVariants=(media.videos[1] as any).variants;
const doctorVideo=doctorVariants[lang]||doctorVariants.en;
const videos=(media.videos as any[]).map((item,index)=>{
 const video=index===1?doctorVideo:item;
 const audio=index===0?c.originalAudio:index===1?c.doctorAudio:video.audio==='en'?visual.english:visual.silent;
 return {...video,title:visual.videoNames[index],audio};
});
const client={...c,items,canonical,lang};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <meta name="robots" content="noindex, nofollow"/>
    <meta name="theme-color" content="#213847"/>
    <title>{c.title} · {price} · {c.season} — IME Clinic</title>
    <meta name="description" content={`${c.lead} ${c.deadline}. ${c.flightNote}.`}/>
    <link rel="canonical" href={canonical}/>
    {langOrder.map(code=><link rel="alternate" hreflang={code} href={smileOrigin+smilePath(code)}/>)}
    <link rel="alternate" hreflang="x-default" href={smileOrigin+smilePath('en')}/>
    <meta property="og:title" content={`${c.title} · ${price}`}/>
    <meta property="og:description" content={`${c.lead} ${c.deadline}. ${c.flightNote}.`}/>
    <meta property="og:type" content="website"/>
    <meta property="og:url" content={canonical}/>
    <meta property="og:image" content={`${smileOrigin}${root}art/winter-${lang}-1.jpg`}/>
    <meta property="og:image:width" content="1080"/><meta property="og:image:height" content="1350"/>
    <link rel="icon" href={`${base}favicon.svg`}/>
    <link rel="preload" href={asset('manrope-latin.woff2')} as="font" type="font/woff2" crossorigin/>
  </head>
  <body data-winter-smile data-view="patient">
    <a class="skip" href="#main">{c.skip}</a>
    <header class="winter-header">
      <div class="winter-wrap header-row">
        <a href="#main" aria-label="IME Clinic" class="winter-logo"><img src={`${base}ime-clinic-logo.svg`} alt="IME Clinic" width="150" height="36"/></a>
        <nav class="desktop-nav" aria-label={c.title}>{anchors.map((id,i)=><a href={`#${id}`}>{c.nav[i]}</a>)}</nav>
        <details class="winter-language"><summary aria-label={c.language}>{lang.toUpperCase()} <span aria-hidden="true">⌄</span></summary><div>{langOrder.map(code=><a href={smilePath(code)} lang={code} hreflang={code} aria-current={code===lang?'page':undefined}>{languages[code]}</a>)}</div></details>
      </div>
    </header>
    <main id="main" class="winter-wrap">
      <div class="offer-top"><span><span aria-hidden="true">✳</span> {c.season}</span><time datetime="2026-12-31">{c.deadline}</time></div>
      <div class="view-switch" aria-label={c.title}><a href="#main" data-view-switch="patient" aria-current="page">{c.patient}</a><a href="?view=advisor#advisor" data-view-switch="advisor">{c.advisor}<span aria-hidden="true">↗</span></a></div>

      <section class="smile-hero" aria-labelledby="smile-title">
        <div class="hero-copy">
          <p class="eyebrow">{c.title}</p>
          <h1 id="smile-title">{c.headline}</h1>
          <p class="hero-lead">{c.lead}</p>
          <div class="hero-price">
            <div>
              <span>{c.priceLabel}</span>
              <strong>{price}</strong>
            </div>
            <p>{c.priceNote}</p>
          </div>
          <div class="hero-actions">
            <button type="button" class="winter-button hero-whatsapp-cta" data-whatsapp data-whatsapp-text={visual.whatsappText}>
              <svg class="wa-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.63C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.81 13.47 3.81 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.04 7.23C8.83 7.23 8.49 7.31 8.2 7.62C7.92 7.94 7.12 8.7 7.12 10.24C7.12 11.78 8.24 13.27 8.4 13.48C8.56 13.69 10.6 16.84 13.72 18.19C14.46 18.51 15.04 18.7 15.49 18.85C16.24 19.08 16.92 19.05 17.46 18.97C18.06 18.88 19.31 18.21 19.57 17.47C19.83 16.73 19.83 16.09 19.75 15.96C19.67 15.83 19.46 15.75 19.14 15.59C18.82 15.43 17.26 14.66 16.97 14.56C16.68 14.45 16.47 14.4 16.26 14.72C16.05 15.03 15.44 15.75 15.26 15.96C15.07 16.17 14.89 16.19 14.57 16.04C14.25 15.88 13.22 15.54 12 14.45C11.05 13.6 10.41 12.56 10.22 12.24C10.04 11.92 10.2 11.75 10.36 11.59C10.5 11.45 10.68 11.22 10.84 11.03C11 10.85 11.05 10.72 11.16 10.51C11.26 10.3 11.21 10.12 11.13 9.96C11.05 9.8 10.43 8.28 10.17 7.66C9.92 7.05 9.66 7.14 9.47 7.13C9.29 7.12 9.08 7.23 9.04 7.23Z"/></svg>
              <span>{visual.whatsappCta}</span>
            </button>
            <a href="#package" class="winter-button light">{c.explore}<span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <figure class="hero-visual"><div class="hero-photo"><img src={asset('natural-smile-1280.webp')} srcset={`${asset('natural-smile-640.webp')} 640w, ${asset('natural-smile-1280.webp')} 1280w`} sizes="(max-width:760px) 100vw, 50vw" alt={visual.portraitAlt} width="1280" height="1920" fetchpriority="high"/></div><figcaption>{visual.modelNote}</figcaption></figure>
      </section>
      <div class="hero-facts">{c.facts.map((text,i)=><div><span class="fact-number">{['20','07','01','↔'][i]}</span><span>{text}</span></div>)}</div>
      <aside class="travel-inclusion" aria-label={c.flight}><div class="travel-photo"><img src={asset('airport-flight-640.webp')} alt={visual.flightAlt} width="640" height="427" loading="lazy"/><span>{visual.illustration}</span></div><div class="travel-copy"><p class="eyebrow"><span aria-hidden="true">✈</span> {c.ticket[4]}</p><h2>{c.flight}</h2><p>{c.flightNote}</p></div><div class="travel-route"><span>{c.ticket[1]}</span><span class="route-line" aria-hidden="true">— ✈ —</span><strong>{c.ticket[2]}</strong></div></aside>
      <nav class="mobile-nav" aria-label={c.title}>{anchors.map((id,i)=><a href={`#${id}`}>{c.nav[i]}</a>)}</nav>

      <section id="package" class="winter-section package-section" aria-labelledby="package-title">
        <div class="section-intro"><p class="eyebrow">{c.packageKicker}</p><h2 id="package-title">{c.packageTitle}</h2><p>{c.packageLead}</p></div>
        <div class="crown-summary"><strong aria-hidden="true">20</strong><div><p class="eyebrow">{visual.toothLabel}</p><h3>{visual.crownTitle}</h3><p>{visual.crownText}</p></div></div>
        <div class="package-grid"><div class="included-box"><h3>{c.included}</h3><ul>{c.includes.map(text=><li><span aria-hidden="true">✓</span>{text}</li>)}</ul></div><div class="scope-box"><h3>{c.scopeTitle}</h3><ul>{c.scope.map(text=><li>{text}</li>)}</ul><details class="material-details"><summary>{c.material}</summary><p>{c.materialText}</p></details></div></div>
      </section>

      <section id="journey" class="winter-section journey-section" aria-labelledby="journey-title"><div class="section-intro"><p class="eyebrow">{c.journeyKicker}</p><h2 id="journey-title">{c.journeyTitle}</h2><p>{c.journeyLead}</p></div><ol class="journey-grid">{c.steps.map(([title,text],i)=><li><span class="step-num">0{i+1}</span><h3>{title}</h3><p>{text}</p></li>)}</ol></section>

      <section id="places" class="winter-section" aria-labelledby="places-title"><div class="section-intro"><p class="eyebrow">{c.placesKicker}</p><h2 id="places-title">{c.placesTitle}</h2><p>{c.placesLead}</p></div><div class="places-grid">{c.places.map(([title,text],i)=><article><div class="place-photo"><img src={asset(['clinic-dental-unit.webp','hotel-room.webp','transfer-vehicle.webp'][i])} alt={title} width="1200" height="800" loading="lazy"/>{i===0&&<button type="button" data-video={clinicVideo.src} data-poster={asset(clinicVideo.localPoster)} data-video-title={c.videoTitle} class="photo-play" aria-label={c.watch}>▶</button>}</div><div class="place-copy"><span class="eyebrow">0{i+1}</span><h3>{title}</h3><p>{text}</p></div></article>)}</div><p class="fine-print">{c.hotelNote}</p>
      </section>

      <section id="videos" class="winter-section video-section" aria-labelledby="videos-title"><div class="section-intro"><p class="eyebrow">IME CLINIC · VIDEO</p><h2 id="videos-title">{visual.videosTitle}</h2><p>{visual.videosLead}</p></div><div class="video-showcase">{videos.map(video=><button type="button" class="showcase-video" data-video={video.src} data-poster={asset(video.localPoster)} data-video-title={video.title}><div><img src={asset(video.localPoster)} alt="" width="360" height="640" loading="lazy"/><span class="showcase-play" aria-hidden="true">▶</span><span class="video-duration">{Math.floor(video.durationSeconds/60)}:{String(Math.floor(video.durationSeconds%60)).padStart(2,'0')}</span></div><strong>{video.title}</strong><small>{video.audio}</small></button>)}</div></section>

      <section id="library" class="winter-section media-section" aria-labelledby="media-title"><div class="section-intro"><p class="eyebrow">{c.mediaKicker}</p><h2 id="media-title">{c.mediaTitle}</h2><p>{c.mediaLead}</p></div>
        <div class="category-tabs" role="tablist" aria-label={c.nav[3]}>{c.categories.map((name,i)=><button type="button" role="tab" id={`category-${i}`} aria-selected={i===0?'true':'false'} aria-controls={`gallery-${i}`} tabindex={i===0?0:-1} data-category={i}>{i===2?visual.travel:name}<span>{items.filter(item=>item.category===i).length}</span></button>)}</div>
        {c.categories.map((_,category)=><div role="tabpanel" id={`gallery-${category}`} aria-labelledby={`category-${category}`} hidden={category!==0} tabindex="0"><div class:list={['media-rail',{'poster-rail':category===0}]}>{items.filter(item=>item.category===category).map((item)=><article class="media-card"><button type="button" data-image={item.id} class="media-image" aria-label={`${c.openImage}: ${item.title}`}><img src={item.thumb} alt={item.title} loading="lazy" decoding="async" width="480" height={category===0?'600':'360'}/><span class="zoom" aria-hidden="true">↗</span></button><div class="media-caption"><span>{item.title}</span><label><input type="checkbox" data-select={item.id} aria-label={`${c.select}: ${item.title}`}/><span>{c.select}</span></label></div></article>)}</div>{category===3&&<p class="fine-print">{c.resultsNote}</p>}{category===5&&<p class="fine-print">{c.guideNote}</p>}</div>)}
        <div class="media-actions"><div><strong data-selection-count>0 {c.selected}</strong><button type="button" data-select-all>{c.selectAll}</button><button type="button" data-clear>{c.clear}</button></div><div><button type="button" class="winter-button secondary" data-download disabled>{c.download} ↓</button><button type="button" class="winter-button" data-share disabled>{c.share} ↗</button></div></div><p class="media-status" role="status" aria-live="polite" data-status></p>
      </section>

      <details id="advisor" class="advisor-section"><summary><span>{c.advisorKicker}</span><span>{c.advisor} <span aria-hidden="true">↗</span></span></summary><div class="advisor-content"><div class="section-intro"><p class="eyebrow">{c.advisorKicker}</p><h2>{c.advisorTitle}</h2><p>{c.advisorLead}</p></div><div class="advisor-stats">{[[c.priceLabel,price],[c.validity,c.deadline],[c.depositLabel,'€300'],[c.nightsLabel,c.facts[1]]].map(([label,value])=><div><span>{label}</span><strong>{value}</strong></div>)}</div><button type="button" class="winter-button secondary" data-copy-link>{c.shareLink}<span aria-hidden="true">↗</span></button><p class="patient-link">{canonical}</p><h3>{c.advisorRulesTitle}</h3><ol class="advisor-rules">{c.advisorRules.map(rule=><li>{rule}</li>)}</ol><h3>{c.scriptsTitle}</h3><div class="scripts-grid">{c.scripts.map((text,index)=><article><div><h4>{c.scriptNames[index]}</h4><button type="button" data-copy={`script-${index}`}>{c.copy}</button></div><textarea id={`script-${index}`} aria-label={c.scriptNames[index]} readonly rows="8">{text}</textarea></article>)}</div><p class="copy-status" role="status" data-copy-status></p></div></details>

      <section id="questions" class="winter-section faq-section" aria-labelledby="faq-title"><div class="section-intro"><p class="eyebrow">{c.faqKicker}</p><h2 id="faq-title">{c.faqTitle}</h2></div><div class="faq-grid">{c.faqs.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
      <section class="next-section">
        <div>
          <p class="eyebrow">{c.deadline}</p>
          <h2>{c.nextTitle}</h2>
          <p>{c.nextText}</p>
        </div>
        <div class="next-actions">
          <button type="button" class="winter-button hero-whatsapp-cta" data-whatsapp data-whatsapp-text={visual.whatsappText}>
            <span>{visual.whatsappCta} 💬</span>
          </button>
          <a href="#package" class="winter-button light">{c.nextCta} ↗</a>
        </div>
      </section>
    </main>
    <footer class="winter-wrap winter-footer"><img src={`${base}ime-clinic-logo.svg`} alt="IME Clinic" width="125" height="30"/><div><span>{c.footer}</span><small>{visual.modelNote} · <a href="https://www.pexels.com/photo/close-up-photo-of-smiling-woman-9253771/" target="_blank" rel="noopener noreferrer">Ron Lach / Pexels</a></small></div></footer>
    <div class="mobile-offer">
      <div class="mobile-offer-info">
        <span>{c.title}</span>
        <small>{price} · {c.deadline}</small>
      </div>
      <div class="mobile-offer-actions">
        <button type="button" class="winter-button mobile-wa-btn" data-whatsapp data-whatsapp-text={visual.whatsappText}>
          <span>💬 WhatsApp</span>
        </button>
        <a href="#package" class="mobile-jump">{c.nav[0]} ↑</a>
      </div>
    </div>
    <dialog id="image-dialog" aria-labelledby="image-dialog-title"><div class="dialog-head"><h2 id="image-dialog-title"></h2><button type="button" data-close-dialog aria-label={c.close}>×</button></div><div class="image-stage"><button type="button" data-image-prev aria-label="←">←</button><img alt=""/><button type="button" data-image-next aria-label="→">→</button></div><a class="winter-button" data-image-download download>{c.downloadOne} ↓</a></dialog>
    <dialog id="video-dialog" aria-labelledby="video-dialog-title"><div class="dialog-head"><h2 id="video-dialog-title">{c.videoTitle}</h2><button type="button" data-close-dialog aria-label={c.close}>×</button></div><div data-video-container></div></dialog>
    <script id="winter-data" type="application/json" set:html={JSON.stringify(client).replaceAll('<','\\u003c')}/>
    <script>import '../scripts/winter-smile-client';</script>
  </body>
</html>
