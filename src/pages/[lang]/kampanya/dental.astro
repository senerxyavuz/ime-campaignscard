---
import WinterSmile from '@/components/WinterSmile.astro';
import { smileLocales } from '@/data/smile-paths.mjs';
import type { SmileLang } from '@/data/winter-i18n';
export function getStaticPaths() { return smileLocales.map(lang=>({params:{lang}})); }
const lang=Astro.params.lang as SmileLang;
---
<WinterSmile lang={lang}/>
